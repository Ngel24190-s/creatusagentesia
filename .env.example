# NosVers Environment Configuration
# Copy this file to .env and fill in your values

# Database
POSTGRES_USER=nosvers
POSTGRES_PASSWORD=changeme_in_production
POSTGRES_DB=nosvers
DATABASE_URL=postgresql+asyncpg://nosvers:changeme_in_production@db:5432/nosvers

# Backend
SECRET_KEY=changeme_generate_with_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
API_PREFIX=/api/v1
DEBUG=true

# WooCommerce Integration
WOOCOMMERCE_URL=https://nosvers.com
WOOCOMMERCE_KEY=
WOOCOMMERCE_SECRET=

# S3 Backup
S3_BUCKET_NAME=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=

# QR / Traceability
PUBLIC_TRACE_URL=https://nosvers.com/trace
